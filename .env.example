# Copier en .env (gitignoré) : cp .env.example .env
# Requis par docker compose (service api) en environnement production.

# Secret de signature des JWT access — OBLIGATOIRE hors développement.
# >= 32 caractères, aléatoire (ex. : openssl rand -hex 32). Ne jamais commiter.
PALET__JWT_SECRET=changez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum

# Optionnels (les valeurs de rust-backend/config/default.toml s'appliquent sinon) :
# PALET__DATABASE_URL=postgres://palet:palet@localhost:5432/palet
# PALET__ENVIRONMENT=production
# PALET__PORT=3000
